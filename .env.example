# Copy to .env for local (non-docker-compose) runs: `set -a && source .env && set +a`.
# docker-compose.yml sets these itself for the containerized stack — you
# don't need this file to run `docker compose up`.

SERVICE_NAME=service-template
LOG_LEVEL=debug

GRPC_PORT=50051
METRICS_PORT=9090

SHUTDOWN_TIMEOUT=20s
HEALTH_CHECK_INTERVAL=10s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=service-template
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=service-template
POSTGRES_SSLMODE=disable

KAFKA_BROKERS=localhost:9092
OUTBOX_TOPIC=service-template.events

OUTBOX_RELAY_POLL_INTERVAL=2s
OUTBOX_RELAY_BATCH_SIZE=100

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
